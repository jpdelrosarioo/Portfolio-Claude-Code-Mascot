# Copy this file to .env.local and fill it in. .env.local is git-ignored — never commit your real key.

# Needed for the "Ask anything" AI box. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
# ASK_MODEL=gemini-3.6-flash   # smarter than the default gemini-3.5-flash-lite
# ASK_HOURLY_LIMIT=15          # questions per visitor per hour
# ASK_DAILY_LIMIT=300          # questions in total per day
